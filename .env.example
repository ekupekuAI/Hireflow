# Copy to .env  (cp .env.example .env) and fill in your own values.
# .env is gitignored — never commit real keys. In production, set these in your
# host's env-var settings (e.g. Vercel → Project → Settings → Environment Variables).

# Supabase — supabase.com → your project → Project Settings → API ("Project URL" and
# the anon/publishable key). The anon key is meant for the browser; Row Level Security
# (supabase/schema.sql) keeps each browser's screenings private. Also enable
# Authentication → Sign In / Providers → "Allow anonymous sign-ins".
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Python ML backend (see /api). Leave unset: defaults to http://localhost:8077 in dev
# and to /api (same-origin Vercel serverless function) in production.
# VITE_ML_API_URL=http://localhost:8077

# Live Claude AI is NOT configured here: VITE_* values are baked into the public JS
# bundle. Each user pastes their own key in the app (⚙ Settings → Live AI); it stays
# in that browser's localStorage. Get a key at console.anthropic.com.
