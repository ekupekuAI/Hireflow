# Copy to .env  (cp .env.example .env) and fill in your own values.
# .env is gitignored — never commit real keys. In production, set these in your
# host's env-var settings (e.g. Vercel → Project → Settings → Environment Variables).

# Supabase — from your project's API settings. The publishable/anon key is meant
# for the browser and is protected by Row Level Security (supabase/schema.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Python ML backend (see /api). Leave unset: defaults to http://localhost:8077 in dev
# and to /api (same-origin Vercel serverless function) in production.
# VITE_ML_API_URL=http://localhost:8077

# Optional: enables live Claude AI (otherwise the app uses its local Demo engine).
# Do NOT ship a real key in the browser for production — proxy it via a Supabase Edge Function.
VITE_ANTHROPIC_API_KEY=
